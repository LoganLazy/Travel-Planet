# 旅行星球 — 环境变量模板
# 复制一份改名叫.env 再填值：cp.env.example.env

# MySQL 连接串（部署文档里建的库名/用户名/密码）
DATABASE_URL="mysql://travel:你的密码@127.0.0.1:3306/travel"

# NextAuth 会话密钥，用下面的命令生成（不要用示例值）：
# openssl rand -base64 32
NEXTAUTH_SECRET="在这里填随机串"

# 对外访问地址，必须和实际域名完全一致（含 https），否则登录会跳错
NEXTAUTH_URL="http://localhost:3000"

# 大模型提供方：openai（走 OpenAI 兼容协议）或 mock（占位攻略，不用 key）
LLM_PROVIDER="openai"
# 大模型 API Key
LLM_API_KEY="你的key"
# OpenAI 兼容接口地址（DeepSeek / 通义 / Kimi / OpenRouter / 自建中转按需改）
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# Nominatim（OpenStreetMap 反向地理编码）使用政策要求的联系方式，
# 必须是真实邮箱或仓库地址，例如你的邮箱或 https://github.com/LoganLazy/Travel-Planet
NOMINATIM_CONTACT="你的邮箱或仓库地址"
